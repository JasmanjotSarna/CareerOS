# ===================================================
# CareerOS — Environment Configuration Template
# Copy this file to .env.local and insert your local credentials.
# NEVER commit .env.local to Git version control.
# ===================================================

# 1. Supabase (PostgreSQL Database, Auth & Storage)
# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only (NEVER expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI Providers (server-only)
# Google Gemini (primary for structured analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (low-latency / transcription)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# OpenRouter (fallback - disabled by default in production)
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-2-9b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CareerOS

# OpenCode (only if verified use case exists per supplied API docs)
OPENCODE_API_KEY=
OPENCODE_API_BASE=https://api.opencode.ai/v2
OPENCODE_MODEL=big-pickle

# NVIDIA Integrate (Nemotron Reasoning)
NVIDIA_API_KEY=
NVIDIA_API_KEY_FALLBACK=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# AI controls
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_USER_LIMIT=100

# 3. Legacy/Optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. App Config
ENABLE_DEV_MOCK_AUTH=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development


