# ===================================================
# CareerOS — Environment Configuration Template
# Copy this file to .env.local and insert your local credentials.
# NEVER commit .env.local to Git version control.
# ===================================================

# 1. Supabase (PostgreSQL Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Anthropic Claude API (Primary Server-Side Reasoning Engine)
# Model: claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. Google Gemini API (Alternative Provider / Secondary)
# Model: gemini-3.6-flash or gemini-flash-latest
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
